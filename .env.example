# ── Server & Database ────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development
MONGODB_URI=mongodb+srv://...

# ── Authentication & Security ────────────────────────────────────────────────
JWT_SECRET=your_jwt_secret_key_here
COOKIE_SECRET=your_cookie_secret_key_here

# ── Payment System Configuration (Manual GPay UPI) ───────────────────────────
# Active provider: MANUAL_UPI (replaceable with future gateways)
PAYMENT_METHOD=MANUAL_UPI
PAYMENT_CURRENCY=INR

# Official Plan Pricing (Server Enforced)
PREMIUM_PRICE_MONTHLY=299
PREMIUM_PRICE_ANNUAL=2499
PREMIUM_PRICE_LIFETIME=4999

# Real Google Pay / UPI QR Asset & Payee Details
UPI_QR_IMAGE=/payment/gpay-qr.png
UPI_ID=aakashleo420@okicici
UPI_PAYEE_NAME=Aakash Leo

# Development only test mode (Disabled in production)
MANUAL_PAYMENT_TEST_MODE=false

# ── Email Service (Optional for Payment Receipts & Alerts) ───────────────────
# Brevo / SMTP / Gmail
EMAIL_PROVIDER=brevo
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password_or_api_key
